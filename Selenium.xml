<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" configfailurepolicy="continue"> 
<listeners>
	<listener class-name="utilities.SeleniumRetryListener"></listener>
	<listener class-name="utilities.SeleniumListener"></listener>
</listeners>
  <test thread-count="5" name="Test">
    <classes>
       <class name="selenium.SearchProducts"/>
       <class name="selenium.AddToCart"/>
       <class name="selenium.FilterProducts"/>
       <class name="selenium.SortingProducts"/>
       <class name="selenium.OrderDetails"/>
   </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
